{
  "name": "lingo-dojo",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Lingo Dojo — composable prompt packs for spoken language practice, with an in-app voice dojo master",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "test": "node --test scripts/tests/*.test.mjs",
    "export": "node scripts/export.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db/setup.mjs --migrate-only",
    "db:setup": "node scripts/db/setup.mjs",
    "db:backup": "node scripts/db/backup-cli.mjs",
    "db:backup:plist": "node scripts/db/backup-cli.mjs --plist",
    "db:import": "node scripts/import.mjs",
    "user": "node scripts/user.mjs",
    "pictures:stock": "node scripts/picture-stock.mjs",
    "pron:record": "node scripts/pronunciation-record.mjs",
    "pron:proof": "node scripts/pronunciation-proof.mjs --recordings"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "ts-fsrs": "^6.0.0",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
