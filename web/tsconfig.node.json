{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    /* The server reads Chinese with the page's own reader
       (server/pronunciation.ts → src/script/zh.ts), whose JSON tables are
       typed by .d.json.ts files, and OpenCC's tables by opencc-dicts.d.ts
       (included below: nothing imports a declaration file). */
    "allowArbitraryExtensions": true,

    /* Bundler mode (vite loads this config with esbuild) */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "server", "shared", "../scripts/db/*.ts", "src/script/opencc-dicts.d.ts"]
}
